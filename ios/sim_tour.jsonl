# CI tour of RawPad in the iPad simulator (ios/sim_test.py). One control request per line;
# {"shot": "name"} takes a real simulator screenshot (xcrun simctl io), {"sleep": s} waits.
{"method":"engine.execute","params":{"command":"library.info"},"expectPhotosAtLeast":1}
{"method":"engine.execute","params":{"command":"view.photoGrid"}}
{"sleep":8}
{"shot":"01-library-grid"}
{"method":"engine.execute","params":{"command":"library.select","params":{"ids":[1]}}}
{"method":"engine.execute","params":{"command":"view.detail"}}
{"method":"engine.execute","params":{"command":"panel.edit"}}
{"sleep":8}
{"shot":"02-develop"}
{"method":"engine.execute","params":{"command":"develop.set","params":{"values":{"light.exposure":0.6,"light.highlights":-55,"light.shadows":35,"color.vibrance":25}}}}
{"method":"engine.execute","params":{"command":"panel.masking"}}
{"method":"engine.execute","params":{"command":"mask.add","params":{"kind":"radial","center":[0.62,0.4],"rx":0.2,"ry":0.14,"feather":70,"name":"Glow"}}}
{"method":"engine.execute","params":{"command":"mask.adjust","params":{"values":{"exposure":0.5,"temp":40}}}}
{"sleep":8}
{"shot":"03-masking"}
# a brush mask painted with a drag (Pencil touches reach the same code without the long-press wait)
{"method":"engine.execute","params":{"command":"tool.brush","params":{"new":true}},"expectOk":true}
{"method":"ui.pointer","params":{"events":[{"kind":"down","x":0.3,"y":0.6},{"kind":"drag","x":0.35,"y":0.62},{"kind":"drag","x":0.4,"y":0.64},{"kind":"drag","x":0.45,"y":0.65},{"kind":"drag","x":0.5,"y":0.66},{"kind":"up","x":0.5,"y":0.66}]},"expectOk":true}
{"method":"engine.execute","params":{"command":"mask.adjust","params":{"values":{"exposure":-1}}},"expectOk":true}
{"sleep":3}
{"shot":"03-brush"}
{"method":"engine.execute","params":{"command":"photo.inspect"}}
# Ivan's iPad (2026-10-19): editing brought up the on-screen keyboard (a tapped or dragged slider
# takes egui's focus). Drag and tap sliders and paint: the log must not show the text-field
# keyboard view taking first responder, and the screenshots must show no keyboard (DECISIONS.md 47)
{"logMark":"editing"}
{"method":"ui.dragWidget","params":{"id":"slider:exposure","fx":0.5,"dx":30,"steps":8},"expectOk":true}
{"method":"ui.clickWidget","params":{"id":"slider:exposure","fx":0.4},"expectOk":true}
{"sleep":2}
{"shot":"07-slider-no-keyboard"}
{"method":"ui.pointer","params":{"events":[{"kind":"down","x":0.2,"y":0.45},{"kind":"drag","x":0.25,"y":0.47},{"kind":"drag","x":0.3,"y":0.49},{"kind":"up","x":0.3,"y":0.49}]},"expectOk":true}
{"sleep":2}
{"shot":"07-brush-no-keyboard"}
{"checkLog":"first responder for text field","since":"editing","absent":true}
# a mostly vertical drag on a slider scrolls the panel and keeps the slider's value (the
# mask's Exposure in 07-slider-no-keyboard and 07-slider-vertical-drag should read the same)
{"method":"ui.dragWidget","params":{"id":"slider:exposure","fx":0.5,"dy":-120,"steps":8},"expectOk":true}
{"sleep":2}
{"shot":"07-slider-vertical-drag"}
# Before/After by touch: the menu right of the Before/After button (bottom bar) lists every view
{"method":"ui.clickWidget","params":{"id":"icon:beforeAfterModes"},"expectOk":true}
{"sleep":2}
{"shot":"08-before-after-menu"}
{"method":"ui.clickWidget","params":{"id":"beforeAfterMode:split"},"expectOk":true}
{"sleep":8}
{"shot":"08-split"}
{"method":"ui.clickWidget","params":{"id":"icon:beforeAfterModes"},"expectOk":true}
{"sleep":1}
{"method":"ui.clickWidget","params":{"id":"beforeAfterMode:topBottom"},"expectOk":true}
{"sleep":8}
{"shot":"08-top-bottom"}
{"method":"ui.clickWidget","params":{"id":"icon:beforeAfterModes"},"expectOk":true}
{"sleep":1}
{"method":"ui.clickWidget","params":{"id":"beforeAfterMode:splitTopBottom"},"expectOk":true}
{"sleep":8}
{"shot":"08-split-top-bottom"}
{"method":"ui.clickWidget","params":{"id":"icon:beforeAfterModes"},"expectOk":true}
{"sleep":1}
{"method":"ui.clickWidget","params":{"id":"beforeAfterMode:original"},"expectOk":true}
{"sleep":6}
{"shot":"08-original"}
# the button itself: side by side, then off again
{"method":"ui.clickWidget","params":{"id":"icon:beforeAfter"},"expectOk":true}
{"sleep":8}
{"shot":"08-side-by-side"}
{"method":"ui.clickWidget","params":{"id":"icon:beforeAfter"},"expectOk":true}
{"sleep":2}
# crop by touch: the Crop panel's Done button (iPad only) applies the crop and goes back to Edit
{"method":"engine.execute","params":{"command":"panel.crop"},"expectOk":true}
{"sleep":6}
{"shot":"09-crop-done-button"}
{"method":"ui.clickWidget","params":{"id":"button:cropDone"},"expectOk":true}
{"sleep":6}
{"shot":"09-crop-applied"}
# Select Several (the photo's long-press menu; a right-click is the same menu): then each tap
# adds a photo to the selection, for Sync (DECISIONS.md 58). Turned off again afterwards.
{"method":"engine.execute","params":{"command":"view.photoGrid"},"expectOk":true}
{"method":"engine.execute","params":{"command":"library.select","params":{"ids":[1]}},"expectOk":true}
{"sleep":4}
{"method":"ui.clickWidget","params":{"id":"thumb:1","button":"right"},"expectOk":true}
{"sleep":2}
{"shot":"10-select-several-menu"}
{"method":"ui.clickWidget","params":{"id":"gridMenu:selectSeveral"},"expectOk":true}
{"sleep":1}
# two photos fully on screen other than photo 1 (run 49: thumb:2 sat above the screen, thumb:3 wasn't laid out)
{"clickVisible":"thumb:","count":2,"exclude":["thumb:1"]}
{"waitUntil":"selected","equals":3,"method":"engine.execute","params":{"command":"library.select","params":{"ids":[],"mode":"add"}},"timeout":10}
{"shot":"10-select-several"}
{"method":"ui.clickWidget","params":{"id":"thumb:1","button":"right"},"expectOk":true}
{"sleep":2}
{"method":"ui.clickWidget","params":{"id":"gridMenu:selectSeveral"},"expectOk":true}
{"sleep":1}
{"method":"engine.execute","params":{"command":"library.select","params":{"ids":[1]}},"expectOk":true}
{"method":"engine.execute","params":{"command":"view.detail"},"expectOk":true}
{"sleep":3}
# phase 4: pinch-zoom and pan in the loupe. ui.zoom is egui's pinch event; real fingers reach the
# same code (detail.rs navigate_gesture) through egui's multi-touch input (zoom_delta/translation_delta)
{"method":"engine.execute","params":{"command":"panel.edit"}}
{"method":"ui.set","params":{"zoom":"fit","pan":[0.5,0.5]},"expectOk":true}
{"sleep":2}
{"method":"ui.pointer","params":{"events":[{"kind":"move","x":0.5,"y":0.5}]},"expectOk":true}
{"sleep":1}
{"method":"ui.zoom","params":{"factor":3},"expectOk":true}
{"waitUntil":"ui.zoom.percent","method":"ui.inspect","timeout":15}
{"sleep":5}
{"shot":"04-pinch-zoom"}
# two-finger pan while zoomed (egui's scroll delta)
{"method":"ui.scroll","params":{"dx":-150,"dy":-100},"expectOk":true}
{"waitUntil":"ui.pan","differs":[0.5,0.5],"method":"ui.inspect","timeout":15}
# one-finger drag pan (recorded in replies.jsonl, not checked yet)
{"method":"ui.pointer","params":{"events":[{"kind":"down","x":0.5,"y":0.5},{"kind":"drag","x":0.47,"y":0.47},{"kind":"drag","x":0.44,"y":0.44},{"kind":"up","x":0.44,"y":0.44}]},"expectOk":true}
{"sleep":3}
{"method":"ui.inspect"}
{"shot":"04-panned"}
{"method":"ui.set","params":{"zoom":"fit","pan":[0.5,0.5]}}
{"sleep":2}
# hardware-keyboard probe, before any sheet (an open share sheet holds the keyboard). Keys come
# from UIKit (native::KeyView; app-stderr.log "keyboard (UIKit):" lines). "5" rates the photo
# (it had 3 stars), ⌘Z undoes that. Soft for now: osascript on the CI Mac decides delivery.
{"method":"engine.execute","params":{"command":"library.select","params":{"ids":[1]}}}
{"hostKeys":"5"}
{"waitUntil":"rating","equals":5,"method":"engine.execute","params":{"command":"photo.inspect","params":{"id":1}},"timeout":10}
{"hostKeys":"z","cmd":true}
{"waitUntil":"rating","equals":3,"method":"engine.execute","params":{"command":"photo.inspect","params":{"id":1}},"timeout":10}
{"shot":"04-keys"}
# on-screen keyboard: a focused text field makes native::TextKeyView (UIKeyInput) first responder
# (app-stderr.log "first responder for text field"); Escape hands it back to KeyView. The
# simulator hides the keyboard while its hardware keyboard is connected, so 04-text-field may not
# show it.
{"logMark":"search"}
{"method":"ui.clickWidget","params":{"id":"field:search"}}
{"sleep":2}
{"shot":"04-text-field"}
{"checkLog":"first responder for text field","since":"search"}
# typing reaches the field once (hardware presses through the text view, never twice): type,
# select all, copy, read ui.inspect → copied. Soft: osascript on the CI Mac decides delivery.
{"hostKeys":"rq"}
{"hostKeys":"a","cmd":true}
{"method":"ui.clipboard","params":{"action":"copy"}}
{"waitUntil":"copied","equals":"rq","method":"ui.inspect","params":{},"timeout":10,"soft":true}
{"method":"ui.key","params":{"key":"Escape"}}
{"sleep":1}
# keyboard avoidance (DECISIONS.md 45): a field low on the screen (the caption in the Info panel)
# lifts the UI above the on-screen keyboard; app-stderr.log "on-screen keyboard covers … UI shrunk by …"
{"method":"ui.set","params":{"right":"info"}}
{"sleep":2}
{"method":"ui.clickWidget","params":{"id":"field:caption"}}
{"sleep":3}
{"shot":"04-caption-keyboard"}
{"method":"ui.key","params":{"key":"Escape"}}
{"method":"engine.execute","params":{"command":"panel.edit"}}
{"sleep":2}
# export: the first export goes to Documents/Exports (Files ▸ On My iPad ▸ RawPad)
{"method":"engine.execute","params":{"command":"app.export","params":{"ids":[1],"format":"jpeg"}},"expectOk":true}
{"sleep":10}
{"checkFiles":"Documents/Exports","min":1}
# a background export, as the Export dialog does (the Share button watches that path). No Photos
# here: the simulator's photolibraryd sometimes never answers (runs 22, 24, 26; DECISIONS.md 38)
{"method":"engine.execute","params":{"command":"app.export","params":{"ids":[2],"format":"jpeg","background":true}},"expectOk":true}
{"waitUntil":"export.last","method":"ui.inspect","timeout":120}
{"sleep":1}
# after an export: the Share button for the files just written (rawpad-ios src/share_offer.rs)
{"method":"ui.widgets","params":{"filter":"rawpadShare"}}
{"shot":"05-share-offer"}
{"method":"ui.clickWidget","params":{"id":"button:rawpadShareExport"},"expectOk":true}
{"sleep":4}
{"shot":"06-share-sheet"}
# the log file (Files ▸ On My iPad ▸ RawPad ▸ Logs)
{"checkFiles":"Documents/Logs","min":1}
# Add to Apple Photos (saved by PHPhotoLibrary on a worker; see replies.jsonl for the outcome).
# Soft: a timeout only warns, because the same code passed in runs 20, 21, 25 and hung in 22, 24, 26
# Not expectOk: with the share sheet over it the app sometimes draws no frame for 5 s and the control
# server refuses the request (run 48, run 49); passed in runs 46 and 47
{"method":"engine.execute","params":{"command":"app.export","params":{"ids":[3],"format":"jpeg","addToPhotos":true,"background":true}}}
{"waitUntil":"imports.imported","method":"engine.execute","params":{"command":"export.photosImports","params":{}},"timeout":180,"soft":true}
{"method":"ui.inspect"}
# (Help › Open Log Folder → share sheet was checked in runs 15/16; a second sheet can't open over this one)
